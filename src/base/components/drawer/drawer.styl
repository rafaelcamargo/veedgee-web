@import '@mixins'

.v-drawer-overlay
  position fixed
  top 0
  right 0
  bottom 0
  left 0
  background-color transparent
  backdrop-filter blur(2px)
  -webkit-backdrop-filter blur(2px)
  opacity 0
  pointer-events none
  transition opacity 200ms ease-out
  z-index var(--vlayer-middle)
  &.is-open
    opacity 1
    pointer-events auto

.v-drawer-wrapper
  position fixed
  right 0
  bottom 0
  left 0
  width 100%
  height calc(100vh - 260px)
  box-sizing border-box
  transform translate3d(0, 100%, 0)
  transition transform 200ms ease-out
  will-change transform
  pointer-events none
  z-index var(--vlayer-high)
  &.is-open
    transform translate3d(0, 0, 0)
    pointer-events auto

.v-drawer
  width 100%
  height 100%
  padding 30px
  background-color var(--vcolor-lightest)
  box-sizing border-box
  border-radius 36px 36px 0 0
  box-shadow -16px 0 48px 0 hsla(0, 0%, 0%, .15)
  overflow hidden

.v-drawer-header
  display flex
  justify-content space-between

.v-drawer-title
  line-height 28px

.v-drawer-body
  margin-top 40px

+breakpoint('sm')
  .v-drawer-overlay
    background-color hsla(228, 5%, 25%, .25)
    backdrop-filter blur(1px)
    -webkit-backdrop-filter blur(1px)
  .v-drawer-wrapper
    top 0
    left auto
    height auto
    max-width 480px
    padding 20px
    transform translate3d(100%, 0, 0)
    &.is-open
      transform translate3d(0, 0, 0)
  .v-drawer
    border-radius 24px
