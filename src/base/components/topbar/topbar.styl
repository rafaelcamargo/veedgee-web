@import '@mixins'

.v-topbar
  position sticky
  display flex
  align-items center
  top 0
  left 0
  width 100%
  height 60px
  background var(--vcolor-lightest)
  box-shadow 0 6px 18px 0 var(--vcolor-grey-lighter)
  z-index var(--vlayer-lowest)
  h1
    position relative
    display flex
    width 84px
    height 40px
    text-indent -9999px
    a
      position absolute
      top 0
      left 0

.v-topbar-content
  display flex
  justify-content space-between
  width 100%
