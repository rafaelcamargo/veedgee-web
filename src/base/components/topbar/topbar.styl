@import '@mixins'

.v-topbar
  position sticky
  display flex
  top 0
  left 0
  width 100%
  height 60px
  padding-top 10px
  background var(--vcolor-lightest)
  box-shadow 0 6px 18px 0 var(--vcolor-grey-lighter)
  border-radius 0 0 24px 24px
  box-sizing border-box
  z-index var(--vlayer-lowest)
  h1
    position relative
    display flex
    width 84px
    height 40px
    text-indent -9999px
    a
      position absolute
      top 0
      left 0

.v-topbar-content
  display flex
  justify-content space-between
  width 100%

+breakpoint('lg')
  .v-topbar
    align-items center
    padding-top 0
    border-radius 0
