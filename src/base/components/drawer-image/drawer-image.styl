.v-drawer-image
  position absolute
  top 0
  left 0
  width 100%
  height 300px
  background-color #000
  overflow hidden
  &.is-loaded
    .v-drawer-image-picture,
    .v-drawer-image-backdrop
      opacity 1

.v-drawer-image-picture,
.v-drawer-image-backdrop
  position absolute
  top 50%
  left 50%
  display block
  width 100%
  height 100%
  opacity 0
  transition opacity 300ms ease-out

.v-drawer-image-picture
  transform translate(-50%, -50%)
  object-fit contain

.v-drawer-image-backdrop
  transform translate(-50%, -50%) scale(1.2)
  object-fit cover
  filter blur(24px)

.v-drawer-image-gradient
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  background linear-gradient(to top, #000, transparent)
  pointer-events none

.v-drawer-image-description
  position absolute
  left 30px
  bottom 30px
  display flex
  align-items center
  gap 10px
  z-index 1
