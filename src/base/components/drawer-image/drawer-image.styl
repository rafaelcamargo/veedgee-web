.v-drawer-image
  position absolute
  top 0
  left 0
  width 100%
  height 300px
  background-color #000
  overflow hidden
  img
    display block
    margin 0 auto
    max-height 300px
    max-width 100%

.v-drawer-image-gradient
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  background linear-gradient(to top, #000, transparent)
  pointer-events none

.v-drawer-image-description
  position absolute
  left 30px
  bottom 30px
  display flex
  align-items center
  gap 10px
  z-index 1
