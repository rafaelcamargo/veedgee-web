.v-event-drawer
  &.has-placeholder-image
    .v-drawer-image
      height 150px
      .v-drawer-image-picture,
      .v-drawer-image-backdrop
        object-position top
    .v-drawer-body
      margin-top 150px

.v-event-drawer
  .v-drawer-body
    .v-icon-clock
      width 26px
      height 26px

.v-event-drawer-row
  & + &
    margin-top 20px

.v-event-drawer-actions
  display flex
  justify-content center
