@import '@mixins'

.v-event-filters-wrapper
  display flex
  align-items center
  gap 12px
  .v-event-filter-field-group
    width auto
    margin-top 0
  .v-event-filter-field-city
    select
      margin-right 5px
      padding-left 0px
      padding-right 30px
      min-width 0
      background-color transparent
      background-image url('../../../base/images/icon-pin.svg')
      background-size 28px
      text-align right
      direction rtl
      border 0
      option
        direction ltr
  .v-event-filters-trigger
    .v-icon
      [data-stroke]
        stroke-width 2.5px

.v-event-filter-fields
  display flex
  flex-direction column

.v-event-filter-field
  position relative
  display flex
  align-items stretch
  flex 1
  min-width 0
  .v-icon-loupe
    position absolute
    left 3px
    top 3px
    width 34px
    height 34px
  .v-event-filter-title
    padding-left 40px
  select,
  input
    width 100%
    min-width 0
  input[type="date"]
    padding-left 6px
    letter-spacing -.5px

.v-event-filter-date-field-divider
  display flex
  align-items center
  flex-shrink 0

.v-event-filter-field-group
  display flex
  width 100%
  min-width 0
  gap 20px
  &:not(:first-child)
    margin-top 20px

.v-event-filter-actions
  display flex
  gap 20px
  margin-top 40px
  .v-button
    flex 1
    min-width 0

+breakpoint('sm')
  .v-event-filter-field
    input[type="date"]
      padding-left 9px
      letter-spacing 0
