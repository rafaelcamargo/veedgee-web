.v-event-filters-wrapper
  .v-event-filters-trigger
    .v-icon
      [data-stroke]
        stroke-width 2.5px

.v-event-filter-fields
  display flex
  flex-direction column

.v-event-filter-field
  position relative
  display flex
  align-items stretch
  width 100%
  &:not(:first-child)
    margin-left 20px
  .v-icon-loupe
    position absolute
    left 3px
    top 3px
    width 34px
    height 34px
  .v-event-filter-title
    padding-left 40px
  select,
  input
    width 100%

.v-event-filter-date-field-divider
  display flex
  align-items center
  margin-left 20px

.v-event-filter-field-group
  display flex
  width 100%
  &:not(:first-child)
    margin-top 20px

.v-event-filter-actions
  display flex
  gap 20px
  margin-top 40px
  .v-button
    flex 1
    min-width 0
