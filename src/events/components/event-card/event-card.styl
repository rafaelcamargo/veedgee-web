.v-event-card
  position relative
  display flex
  flex-direction column
  padding 20px
  height 240px
  background-color var(--vcolor-lightest)
  border-radius 12px
  .v-event-card-details-link
    position absolute
    right 20px
    bottom 30px
    display flex
    align-items center
    justify-content center
    width 60px
    height 60px
    padding 0
    background-color var(--vcolor-red-light)
    border 0
    border-radius 50%
    cursor pointer
    z-index var(--vlayer-base)
  address
    display flex
    align-items center
    position absolute
    left 0
    bottom 0
    padding 20px
    width 100%
    color var(--vcolor-grey-dark)
    font-style normal
    font-size var(--vfont-size-xxs)
    font-weight bold
    text-transform uppercase
    border-top 1px solid var(--vcolor-grey-mid-lighter)
    box-sizing border-box
  .v-icon
    width 26px
    height 26px

.v-event-card-header
  display flex
  align-items center
  gap 8px

.v-event-card-title-wrapper
  position relative
  flex 1
  min-height 0
  max-height 150px
  margin-top 15px
  overflow hidden
  h2
    position absolute
    top 0
    left 0
